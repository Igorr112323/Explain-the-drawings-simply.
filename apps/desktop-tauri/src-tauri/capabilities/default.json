{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Главное окно IkGuide: нативный диалог «Сохранить как…» и запись PDF, который выбрал человек.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "$DESKTOP/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    }
  ]
}
