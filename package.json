{
  "name": "ikguide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IkGuide — 2D-чертёж в понятную PDF-инструкцию в стиле IKEA.",
  "workspaces": [
    "packages/*",
    "apps/studio-web"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run dev -w @ikguide/studio-web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:native": "node scripts/check-native-configs.mjs",
    "build": "npm run build:packages && npm run build -w @ikguide/studio-web",
    "build:packages": "npm run build -w @ikguide/schema -w @ikguide/gost-translator -w @ikguide/builder",
    "dev:vision": "bash services/vision-api/run.sh dev",
    "dev:all": "bash scripts/dev-all.sh",
    "install:vision": "bash services/vision-api/run.sh install",
    "test:vision": "bash services/vision-api/run.sh test",
    "desktop:dev": "npm --prefix apps/desktop-tauri run dev",
    "desktop:build": "npm --prefix apps/desktop-tauri run build",
    "desktop:icons": "bash apps/desktop-tauri/scripts/make-icons.sh",
    "backend": "bash scripts/start-backend.sh",
    "install:backend": "bash scripts/start-backend.sh install"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "yaml": "^2.9.1"
  }
}
