{
  "name": "@ikguide/schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single .ikguide document format: Zod schemas, validation and helpers.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
