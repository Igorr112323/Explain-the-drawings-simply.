{
  "name": "@ikguide/pdf-exporter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turns an IkGuide instruction into a real binary PDF (IKEA-style A4 pages, embedded Cyrillic font, vector SVG diagrams) right in the browser.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./plan": {
      "types": "./src/plan.ts",
      "default": "./src/plan.ts"
    },
    "./text": {
      "types": "./src/text.ts",
      "default": "./src/text.ts"
    },
    "./render": {
      "types": "./src/render.ts",
      "default": "./src/render.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@ikguide/schema": "0.1.0",
    "jspdf": "^4.2.1",
    "svg2pdf.js": "^2.9.0"
  }
}
