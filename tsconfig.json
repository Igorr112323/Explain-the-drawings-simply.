{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "paths": {
      "@ikguide/schema": ["packages/ikguide-schema/src/index.ts"],
      "@ikguide/gost-translator": ["packages/gost-translator/src/index.ts"],
      "@ikguide/builder": ["packages/ikguide-builder/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/studio-web/src/**/*.ts",
    "apps/studio-web/src/**/*.tsx",
    "apps/studio-web/vite.config.ts",
    "apps/mobile-capacitor/capacitor.config.ts",
    "vitest.config.ts"
  ]
}
